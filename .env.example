# Copier ce fichier en .env à la racine du projet avant de lancer docker compose.
# Les variables laissées vides ci-dessous sont OBLIGATOIRES : docker compose
# refuse de démarrer tant qu'elles ne sont pas remplies.
# Pour générer un secret : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# (ou : openssl rand -hex 48)

# ── Base de données ─────────────────────────────────────────────────────────
POSTGRES_USER=postgres
# Obligatoire — choisissez un mot de passe long et unique
POSTGRES_PASSWORD=
POSTGRES_DB=santefamille

# ── pgAdmin (profil « dev ») ────────────────────────────────────────────────
PGADMIN_EMAIL=admin@santefamille.com
# Obligatoire (même si pgAdmin n'est pas lancé)
PGADMIN_PASSWORD=

# ── Sécurité ────────────────────────────────────────────────────────────────
# Secrets JWT — obligatoires, au moins 32 caractères, différents l'un de
# l'autre (le serveur refuse de démarrer sinon, en production)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Cookies de session « Secure » (HTTPS uniquement). Obligatoire en production
# (NODE_ENV=production, valeur par défaut dans Docker) : le serveur refuse de
# démarrer sinon. Fonctionne aussi en local sur http://localhost (Chrome,
# Edge, Firefox considèrent localhost comme sûr). Pour un essai en HTTP sur
# une autre adresse (IP du réseau local) : COOKIE_SECURE=false ET
# NODE_ENV=development — jamais en production.
COOKIE_SECURE=true
# NODE_ENV=production

# Clé de chiffrement des jetons de fiche d'urgence (QR codes). Facultative :
# à défaut, elle est dérivée de JWT_ACCESS_SECRET. Recommandée en production,
# pour pouvoir changer les secrets JWT sans rendre les QR codes non
# réaffichables (les QR codes imprimés restent valables dans tous les cas).
EMERGENCY_TOKEN_KEY=

# ── Courriels ───────────────────────────────────────────────────────────────
# Par défaut : MailHog, boîte de test locale (aucun courriel ne part
# réellement). Lancer `docker compose --profile dev up`, puis consulter les
# courriels sur http://localhost:8025 (MAILHOG_UI_PORT).
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SunuSanté Famille <no-reply@santefamille.local>

# Envoi réel avec Gmail (remplace le bloc MailHog ci-dessus) :
# 1. Activer la validation en 2 étapes sur le compte Google
# 2. Créer un mot de passe d'application sur https://myaccount.google.com/apppasswords
# 3. Renseigner l'adresse Gmail et ce mot de passe généré (PAS le vrai mot de passe Gmail)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tonadresse@gmail.com
# SMTP_PASS=ton_mot_de_passe_dapplication_16_caracteres
# SMTP_FROM=SunuSanté Famille <tonadresse@gmail.com>

# Secret de réception des rebonds de courriel (service d'envoi type Brevo, une
# fois l'application en ligne). À transmettre de préférence dans l'en-tête
# X-Webhook-Secret de POST https://<domaine>/api/webhooks/mail, sinon dans
# l'adresse : https://<domaine>/api/webhooks/mail/<secret>. Vide = désactivé.
MAIL_WEBHOOK_SECRET=

# ── Application ─────────────────────────────────────────────────────────────
# URL publique du frontend : liens des courriels, et seule origine autorisée
# à appeler l'API (CORS et contrôle d'origine). À aligner sur FRONTEND_PORT.
FRONTEND_URL=http://localhost:8080
# Fuseau horaire de référence pour les rappels (heures de prise, « aujourd'hui »)
APP_TIMEZONE=Africa/Dakar

# ── Ports exposés sur la machine hôte (valeurs par défaut) ──────────────────
# À changer si un autre projet les occupe déjà ; penser alors à aligner
# FRONTEND_URL sur FRONTEND_PORT.
FRONTEND_PORT=8080
BACKEND_PORT=4000
DB_HOST_PORT=5432
PGADMIN_PORT=5050
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
