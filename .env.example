# Copier ce fichier en .env à la racine du projet avant de lancer docker compose

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=santefamille

PGADMIN_EMAIL=admin@santefamille.com
PGADMIN_PASSWORD=admin

# Origine autorisée pour le CORS du backend (utile hors Docker / accès direct à l'API)
CORS_ORIGIN=http://localhost:8080

# Secrets JWT — À CHANGER en production (ex: openssl rand -hex 32)
JWT_ACCESS_SECRET=changeme_access_secret
JWT_REFRESH_SECRET=changeme_refresh_secret

# Mettre à "true" uniquement si l'app est servie en HTTPS
COOKIE_SECURE=false

# Envoi d'emails (invitations) — configuration Gmail (recommandé pour un vrai envoi)
# 1. Active la validation en 2 étapes sur ton compte Google
# 2. Crée un mot de passe d'application sur https://myaccount.google.com/apppasswords
# 3. Renseigne ton adresse Gmail et ce mot de passe généré ci-dessous (PAS ton vrai mot de passe Gmail)
# (Mailhog reste disponible dans ce docker-compose si tu veux temporairement tester
# sans vrai envoi : interface web sur http://localhost:8025 — remets alors
# SMTP_HOST=mailhog, SMTP_PORT=1025, SMTP_USER et SMTP_PASS vides.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tonadresse@gmail.com
SMTP_PASS=ton_mot_de_passe_dapplication_16_caracteres
SMTP_FROM=SantéFamille <tonadresse@gmail.com>

# URL publique du frontend, utilisée pour construire les liens d'invitation
FRONTEND_URL=http://localhost:8080