# Lancement du backend HORS Docker (npm run dev), avec PostgreSQL local ou
# celui de docker compose (port DB_HOST_PORT, 5432 par défaut).
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/santefamille
# development : avertissements seulement pour les secrets faibles et
# COOKIE_SECURE. production : le serveur refuse de démarrer dans ces cas.
NODE_ENV=development

# Secrets JWT — au moins 32 caractères, différents l'un de l'autre.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# "true" obligatoire en production (HTTPS). En local sur http://localhost,
# "true" fonctionne aussi dans Chrome, Edge et Firefox.
COOKIE_SECURE=false

# Clé de chiffrement des jetons de fiche d'urgence (facultative ; dérivée de
# JWT_ACCESS_SECRET à défaut — voir .env.example à la racine)
EMERGENCY_TOKEN_KEY=

# Clé maîtresse du chiffrement des documents (32 octets, base64 ou hex).
# Obligatoire en production ; en développement, dérivée de JWT_ACCESS_SECRET
# à défaut (avertissement au démarrage). Générer :
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ Sa perte rend les documents irrécupérables : la sauvegarder à part, hors
# du serveur et des sauvegardes de fichiers. Rotation : DOCUMENTATION.md §9.1.
DOCUMENTS_ENCRYPTION_KEY=
DOCUMENTS_ENCRYPTION_KEY_PREVIOUS=

# Courriels : MailHog par défaut (docker compose --profile dev up, puis
# http://localhost:8025). Pour Gmail, voir .env.example à la racine.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SunuSanté Famille <no-reply@santefamille.local>

# URL publique du frontend : liens des courriels, et seule origine autorisée
# à appeler l'API (CORS)
FRONTEND_URL=http://localhost:5173
# Fuseau horaire de référence pour les rappels (heures de prise, « aujourd'hui »)
APP_TIMEZONE=Africa/Dakar
# Secret de réception des rebonds de courriel (en-tête X-Webhook-Secret ou
# adresse /api/webhooks/mail/<secret>). Vide = désactivé.
MAIL_WEBHOOK_SECRET=

# ── Notifications push (application installable) ───────────────────────────
# Facultatives : vides, les rappels restent dans la cloche et par courriel,
# sans notification sur le téléphone (simple avertissement au démarrage).
# Clés VAPID : identifient ce serveur auprès des services push des
# navigateurs (Google, Mozilla, Apple), sans compte ni service payant.
# Générer UNE FOIS (dans Backend/) : npx web-push generate-vapid-keys
# puis copier « Public Key » et « Private Key » ci-dessous. Ne plus les
# changer ensuite : chaque appareil abonné devrait se réabonner.
# VAPID_SUBJECT : adresse de contact de l'exploitant, au format mailto:
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@santefamille.local
