PORT=4000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/santefamille
CORS_ORIGIN=http://localhost:5173

# Secrets JWT — à générer aléatoirement en production (ex: openssl rand -hex 32)
JWT_ACCESS_SECRET=changeme_access_secret
JWT_REFRESH_SECRET=changeme_refresh_secret

# Mettre à "true" uniquement si l'app est servie en HTTPS (sinon les cookies
# "secure" seraient rejetés par le navigateur)
COOKIE_SECURE=false

# Envoi d'emails (invitations) — configuration Gmail (recommandé pour un vrai envoi)
# 1. Active la validation en 2 étapes sur ton compte Google
# 2. Crée un mot de passe d'application sur https://myaccount.google.com/apppasswords
# 3. Renseigne ton adresse Gmail et ce mot de passe généré ci-dessous (PAS ton vrai mot de passe Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tonadresse@gmail.com
SMTP_PASS=ton_mot_de_passe_dapplication_16_caracteres
SMTP_FROM=SunuSanté Famille <tonadresse@gmail.com>

# URL publique du frontend, utilisée pour construire les liens d'invitation
FRONTEND_URL=http://localhost:5173